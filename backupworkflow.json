    {
      "parameters": {
        "jsCode": "let existingFiles = [];\ntry {\n  const storeNode = $('Store repo files').first();\n  existingFiles = storeNode.json.existingFiles || [];\n} catch (e) {\n  try {\n    existingFiles = $('List files from repo').all().map(item => item.json.name).filter(Boolean);\n  } catch (err) {\n    existingFiles = [];\n  }\n}\n\nconst results = [];\nconst nowStr = $now.setZone('UTC').toFormat('yyyy-MM-dd/HH:mm');\n\nfor (const item of $input.all()) {\n  const wf = item.json;\n  if (!wf || !wf.name) continue;\n\n  const rawName = String(wf.name).trim();\n\n  const directName = `${rawName.replace(/[/\\\\?%*:|\"<>]/g, '_')}.json`;\n  const dashSlug = `${rawName.toLowerCase().replace(/\\s+/g, '-').replace(/[^a-z0-9-_.]/g, '')}.json`;\n  const compactName = `${rawName.toLowerCase().replace(/[^a-z0-9.]/g, '')}.json`;\n\n  let targetFileName = dashSlug;\n  let fileExists = false;\n\n  if (existingFiles.includes(directName)) {\n    targetFileName = directName;\n    fileExists = true;\n  } else if (existingFiles.includes(dashSlug)) {\n    targetFileName = dashSlug;\n    fileExists = true;\n  } else if (existingFiles.includes(compactName)) {\n    targetFileName = compactName;\n    fileExists = true;\n  } else {\n    const caseMatch = existingFiles.find(f => \n      f.toLowerCase() === directName.toLowerCase() || \n      f.toLowerCase() === dashSlug.toLowerCase() || \n      f.toLowerCase() === compactName.toLowerCase()\n    );\n    if (caseMatch) {\n      targetFileName = caseMatch;\n      fileExists = true;\n    } else {\n      targetFileName = dashSlug;\n      fileExists = false;\n    }\n  }\n\n  const exportData = {\n    name: wf.name,\n    nodes: wf.nodes || [],\n    connections: wf.connections || {},\n    settings: wf.settings || {},\n    staticData: wf.staticData || null,\n    pinData: wf.pinData || {},\n    versionId: wf.versionId || undefined,\n    meta: wf.meta || undefined,\n    tags: wf.tags || []\n  };\n\n  results.push({\n    json: {\n      id: wf.id,\n      workflowName: rawName,\n      fileName: targetFileName,\n      fileExists: fileExists,\n      commitMessage: `backup-${nowStr}`,\n      fileContent: JSON.stringify(exportData, null, 2)\n    }\n  });\n}\n\nreturn results;"
      },
