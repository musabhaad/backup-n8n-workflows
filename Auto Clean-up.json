    {
      "parameters": {
        "jsCode": "\nconst rows=$input.all().map(i=>i.json);\nconst out=[]; const nowIso=DateTime.now().setZone('Europe/Berlin').toFormat('yyyy-MM-dd HH:mm:ss');\nfor(const r of rows){\n  const status=(r.emailStatus||'').toString().trim().toLowerCase();\n  const attempts=Number(r.attempts)||0;\n  if(status!=='pending') continue;\n  if(!r.companyWebsite) continue;\n  // age safety-net: a single errored daily CLN run used to stall expiry; expire by age too so the\n  // funnel always closes within ~4 days regardless of how many daily runs actually succeeded.\n  let ageDays=null;\n  if(r.createdAt){ const cdt=DateTime.fromFormat(String(r.createdAt).trim(),'yyyy-MM-dd HH:mm:ss',{zone:'Europe/Berlin'}); if(cdt.isValid) ageDays=DateTime.now().setZone('Europe/Berlin').diff(cdt,'days').days; }\n  const tooOld = ageDays!==null && ageDays>=4;\n  if(attempts>=3 || tooOld){ out.push({json:{...r, emailStatus:'not_found', _action:'expire'}}); }\n  else { out.push({json:{...r, attempts:attempts+1, lastAttemptAt:nowIso, _action:'retry'}}); }\n}\nreturn out;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -496,
        400
      ],
