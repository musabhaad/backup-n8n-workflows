    {
      "parameters": {
        "jsCode": "const all=$('Classify pending').all();\nconst retried=all.filter(i=>i.json._action==='retry').length;\nconst expired=all.filter(i=>i.json._action==='expire').length;\n\n// --- Soft-failure aggregation from the full sheet read CLN already does (zero extra reads) ---\n// emailStatus vocabulary (verified live): found=verified+sent (good) | invalid=zbInvalid |\n// not_found=amfNoContact (pending expired) | pending | backup(-bk) | suppressed | exhausted(WF6)\nconst rows=$('Get row(s) in sheet').all().map(i=>i.json);\nconst norm=s=>(s||'').toString().trim().toLowerCase();\nlet found=0,invalid=0,notFoundT=0,pending=0,backup=0,suppressed=0,exhausted=0;\nfor(const r of rows){\n  const s=norm(r.emailStatus);\n  if(s==='found')found++;\n  else if(s==='invalid')invalid++;\n  else if(s==='not_found')notFoundT++;\n  else if(s==='pending')pending++;\n  else if(s==='backup')backup++;\n  else if(s==='suppressed')suppressed++;\n  else if(s==='exhausted')exhausted++;\n}\nconst verified=found+invalid;\nconst invalidRate=verified?Math.round(invalid/verified*100):0;       // bounce-quality (zbInvalid)\nconst resolved=found+invalid+notFoundT;\nconst noContactRate=resolved?Math.round(notFoundT/resolved*100):0;    // amfNoContact (not_found / resolved AMF lookups)\n\n// Thresholds — quiet default, loud only on spike (min sample guards against noise)\nconst THRESH_INVALID=30, THRESH_NOCONTACT=60;\nconst alerts=[];\nif(verified>=10 && invalidRate>THRESH_INVALID) alerts.push('⚠ ZeroBounce invalid rate '+invalidRate+'% ('+invalid+'/'+verified+')');\nif(resolved>=10 && noContactRate>THRESH_NOCONTACT) alerts.push('⚠ AMF no-contact rate '+noContactRate+'% ('+notFoundT+'/'+resolved+')');\nconst alertLine=alerts.length?'\\n'+alerts.join('\\n'):'';\n\n// Sheet row: IDENTICAL columns/semantics to before. _-prefixed fields are for the Discord digest only\n// (autoMapInputData drops keys with no matching header column).\nreturn [{json:{ runId:$execution.id, startedAt:'', finishedAt:DateTime.now().setZone('Europe/Berlin').toFormat('yyyy-MM-dd HH:mm:ss'),\n  workflow:'Auto Clean-up', scraped:'', ruleFiltered:'', duplicates:'', aiRejected:'', aiPassed:'', amfSent:'',\n  callbacks:'', valid:'', invalid:'', found:'', sentSmartlead:'', notFound:expired, pendingChecked:all.length, retried:retried, expired:expired,\n  _found:found, _invalid:invalid, _invalidRate:invalidRate, _notFoundTotal:notFoundT, _noContactRate:noContactRate,\n  _pending:pending, _backup:backup, _suppressed:suppressed, _exhausted:exhausted, _alertLine:alertLine }}];"
      },
