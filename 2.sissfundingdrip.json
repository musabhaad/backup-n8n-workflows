          "cachedResultUrl": "https://docs.google.com/spreadsheets/d/1_KI5rgF7pweS-veuvKJ-Xt0E9VgrTtLHbuPBs1bfYOs/edit#gid=1760052950"
        },
        "options": {}
      },
      "id": "fd-read",
      "name": "Get Funding Signals",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        160,
        448
      ],
      "alwaysOutputData": true,
      "retryOnFail": false,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "executeOnce": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "FqUaNFxZiMgiZ0gS",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Funding_Signal is the pilot queue. Release exactly one row per run.\n// Google Sheets can hand back a real boolean, the string 'FALSE', or an\n// empty cell depending on how the value was entered, so treat all three\n// as unpushed rather than testing for one shape.\nconst isUnpushed = (v) => {\n  const s = String(v === undefined || v === null ? '' : v).trim().toLowerCase();\n  return s === '' || s === 'false' || s === 'no' || s === '0';\n};\n\nconst pending = $input.all()\n  .map(i => i.json)\n  .filter(r => String(r.id || '').trim() && isUnpushed(r.addedToJobs));\n\n// Nothing left to push. Return no items so the rest of the chain is skipped\n// instead of appending a blank row to JOB's.\nif (pending.length === 0) return [];\n\n// Oldest announcement first. A June round loses relevance faster than an\n// August one, so it should not sit at the back of the queue.\npending.sort((a, b) => String(a.postedAt || '').localeCompare(String(b.postedAt || '')));\n\nreturn [{ json: pending[0] }];"
      },
      "id": "fd-pick",
      "name": "Pick One Signal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        448
      ]
    },
    {
      "parameters": {
        "jsCode": "// JOB's already carries signalType, fundingRound, fundingAmount and investors,\n// so most of this is a pass-through. Only four columns need real work.\nconst f = $input.first().json;\nconst s = (v) => (v === undefined || v === null) ? '' : String(v);\nconst today = new Date().toISOString().slice(0, 10);\n\nconst round = s(f.fundingRound).trim();\nconst roundLabel = round\n  ? round.replace(/\\b\\w/g, (c) => c.toUpperCase())\n  : 'Funding';\n\nconst amount = s(f.fundingAmount).trim();\nconst prettyAmount = amount && !isNaN(Number(amount))\n  ? Number(amount).toLocaleString('en-US')\n  : amount;\n\n// JOB's has no companyIndustry, currency, roundFlavor or signalConfidence\n// column. Fold them into leadNotes so the funding detail is not lost.\nconst notes = [\n  round ? 'Round: ' + roundLabel : '',\n  prettyAmount ? 'Amount: ' + prettyAmount + ' ' + (s(f.currency) || 'USD') : '',\n  s(f.roundFlavor) ? 'Flavor: ' + s(f.roundFlavor) : '',\n  s(f.companyIndustry) ? 'Industry: ' + s(f.companyIndustry) : '',\n  s(f.signalConfidence) ? 'Source confidence: ' + s(f.signalConfidence) : '',\n  'Released from Funding_Signal on ' + today\n].filter(Boolean).join(' | ');\n\nreturn [{ json: {\n  id: s(f.id),\n  signalType: s(f.signalType) || 'funding_round',\n  functionalArea: s(f.functionalArea),\n  dedupKey: s(f.dedupKey),\n  companyKey: s(f.companyKey),\n  contactRound: s(f.contactRound) || '1',\n  companyName: s(f.companyName),\n  country: s(f.country),\n  companyWebsite: s(f.companyWebsite),\n  companyLinkedinUrl: s(f.companyLinkedinUrl),\n  companyEmployeesCount: s(f.companyEmployeesCount),\n  companyDescription: s(f.companyDescription),\n  location: s(f.location),\n\n  // No job post exists behind a funding signal. Give the dashboard a\n  // readable label instead of leaving the column blank.\n  jobOpeningTitle: roundLabel + ' funding, ' + (s(f.functionalArea) || 'capability') + ' build',\n\n  link: s(f.link),\n  postedAt: s(f.postedAt),\n  personFullName: s(f.personFullName),\n  personJobTitle: s(f.personJobTitle),\n  personLinkedinUrl: s(f.personLinkedinUrl),\n  fundingRound: round,\n  fundingAmount: amount,\n  investors: s(f.investors),\n\n  // The JOB's header carries a trailing space. Writing 'LeadStatus' without\n  // it silently leaves the column empty.\n  'LeadStatus ': s(f.LeadStatus) || 'New',\n\n  leadNotes: '',\n  zerobounceStatus: '',\n  emailStatus: '',\n  icebreaker: s(f.icebreaker),\n  dmCategory: s(f.functionalArea),\n  confidence: s(f.confidence),\n  needsReview: s(f.needsReview),\n  alternativeBuyers: s(f.alternativeBuyers),\n  whyPersonSelected: s(f.whyPersonSelected),\n  whySignalMatters: s(f.whySignalMatters),\n  candidateCount: s(f.candidateCount),\n  signalStrength: s(f.signalStrength),\n  attempts: s(f.attempts) || '0',\n  lastAttemptAt: '',\n  addedToCampaign: 'FALSE',\n  createdAt: today,\n  leadStage: s(f.leadStage) || 'new',\n  email: s(f.email),\n  leadStageUpdatedAt: '',\n  triedCategories: '',\n\n  // The funding rationale is the context the dashboard renders where a job\n  // post would otherwise sit.\n  jobDescription: s(f.whySignalMatters)\n}}];"
      },
      "id": "fd-map",
      "name": "Map Funding to JOBs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
